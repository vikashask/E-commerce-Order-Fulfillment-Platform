import { Injectable, NotFoundException, ConflictException, BadRequestException } from '@nestjs/common';
import { pool } from '../database/pool.js';

@Injectable()
export class CartService {
  async getOrCreateCart(customerId?: string, sessionId?: string) {
    if (customerId) {
      const { rows } = await pool.query(
        `SELECT * FROM carts WHERE customer_id = $1 AND status = 'active' ORDER BY created_at DESC LIMIT 1`,
        [customerId],
      );
      if (rows.length) return rows[0];
    }
    const { rows } = await pool.query(
      `INSERT INTO carts (customer_id, session_id) VALUES ($1::uuid, $2::uuid) RETURNING *`,
      [customerId || null, sessionId || null],
    );
    return rows[0];
  }

  async getCart(cartId: string) {
    const { rows: carts } = await pool.query('SELECT * FROM carts WHERE id = $1::uuid', [cartId]);
    if (!carts.length) throw new NotFoundException('Cart not found');
    const { rows: items } = await pool.query(
      'SELECT * FROM cart_items WHERE cart_id = $1::uuid ORDER BY added_at', [cartId],
    );
    return { ...carts[0], items };
  }

  async addItem(cartId: string, variantId: string, sku: string, productName: string, quantity: number) {
    if (quantity < 1 || quantity > 999) throw new BadRequestException('Invalid quantity');
    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      const { rows: carts } = await client.query('SELECT * FROM carts WHERE id = $1::uuid FOR UPDATE', [cartId]);
      if (!carts.length) throw new NotFoundException('Cart not found');
      // Upsert item
      const { rows } = await client.query(
        `INSERT INTO cart_items (cart_id::uuid, variant_id, sku, product_name, quantity)
         VALUES ($1::uuid, $2::uuid, $3, $4, $5)
         ON CONFLICT (cart_id, variant_id) DO UPDATE SET quantity = cart_items.quantity + EXCLUDED.quantity, updated_at = now()
         RETURNING *`,
        [cartId, variantId, sku, productName, quantity],
      );
      await client.query('UPDATE carts SET version = version + 1, updated_at = now() WHERE id = $1::uuid', [cartId]);
      await client.query('COMMIT');
      return rows[0];
    } catch (e) {
      await client.query('ROLLBACK');
      throw e;
    } finally {
      client.release();
    }
  }

  async updateItemQuantity(cartId: string, itemId: string, quantity: number) {
    if (quantity < 1 || quantity > 999) throw new BadRequestException('Invalid quantity');
    const { rows } = await pool.query(
      'UPDATE cart_items SET quantity = $1, updated_at = now() WHERE id = $2::uuid AND cart_id = $3 RETURNING *',
      [quantity, itemId, cartId],
    );
    if (!rows.length) throw new NotFoundException('Cart item not found');
    await pool.query('UPDATE carts SET version = version + 1, updated_at = now() WHERE id = $1::uuid', [cartId]);
    return rows[0];
  }

  async removeItem(cartId: string, itemId: string) {
    const { rowCount } = await pool.query('DELETE FROM cart_items WHERE id = $1::uuid AND cart_id = $2', [itemId, cartId]);
    if (!rowCount) throw new NotFoundException('Cart item not found');
    await pool.query('UPDATE carts SET version = version + 1, updated_at = now() WHERE id = $1::uuid', [cartId]);
    return { deleted: true };
  }

  async clearCart(cartId: string) {
    await pool.query('DELETE FROM cart_items WHERE cart_id = $1::uuid', [cartId]);
    await pool.query("UPDATE carts SET status = 'checked_out', version = version + 1, updated_at = now() WHERE id = $1::uuid", [cartId]);
  }
}
